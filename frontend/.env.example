# Copy to .env.local for local development.
#
# Base URL of the NeedleSift API (no trailing slash).
# - Unset in development  -> http://localhost:8080 (backend run via uvicorn, see ../DEPLOY.md)
# - Unset in production   -> same origin (the backend container serves this frontend)
#
# To develop against the deployed backend without running it locally:
# NEXT_PUBLIC_API_BASE_URL=https://needlesift-297927793190.asia-southeast1.run.app
NEXT_PUBLIC_API_BASE_URL=
